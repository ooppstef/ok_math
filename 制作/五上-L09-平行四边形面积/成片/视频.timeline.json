  "burn_captions": true,
  "scenes": [
    {
      "id": "01",
      "start": 0.0,
      "duration": 6.666666666666667,
      "narration": "底是六厘米。这条垂直到底边的线长三厘米，它才是高。",
      "speech_duration": 5.64,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 6.666667,
      "duration": 4.25,
      "narration": "沿着高，把左边这个三角形剪下来。",
      "speech_duration": 3.24,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 10.916667,
      "duration": 6.625,
      "narration": "把这一块向右移，补在另一边。没有拉长，也没有丢掉。",
      "speech_duration": 5.616009070294784,
      "pause_after": 1
    },
    {
      "id": "04",
      "start": 17.541667,
      "duration": 8.625,
      "narration": "拼成的长方形，长六厘米，宽三厘米。面积是十八平方厘米。",
      "speech_duration": 6.624013605442177,
      "pause_after": 2
    },
    {
      "id": "05",
      "start": 26.166667,
      "duration": 14.25,
      "narration": "底和高都不变，只把上边往右推一点，面积会变吗？先想一想。",
      "speech_duration": 6.24,
      "pause_after": 8
    },
    {
      "id": "06",
      "start": 40.416667,
      "duration": 7.25,
      "narration": "还是十八平方厘米。形状更斜了，垂直的高度没有变。",
      "speech_duration": 5.232018140589569,
      "pause_after": 2
    }
  ]
}
