      "start": 0.0,
      "duration": 2.6666666666666665,
      "narration": "先取整块的三分之二。",
      "speech_duration": 2.04,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l01_s2_1",
      "start": 2.666667,
      "duration": 2.6666666666666665,
      "narration": "再取这部分的四分之三。",
      "speech_duration": 2.04,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l01_s3_1",
      "start": 5.333333,
      "duration": 9.458333333333334,
      "narration": "重叠有六小格，整块一共十二小格，所以是十二分之六，也就是一半。",
      "speech_duration": 8.856009070294785,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l01_s4_1",
      "start": 14.791667,
      "duration": 12.458333333333334,
      "narration": "分母的二十，和分子的六，分别数的是什么？",
      "speech_duration": 4.44,
      "pause_after": 8
    },
    {
      "id": "g6a_l01_s5_1",
      "start": 27.25,
      "duration": 7.458333333333333,
      "narration": "二十是全部小格，六是取到的小格，结果约分后是十分之三。",
      "speech_duration": 6.84,
      "pause_after": 0.6
    }
  ]
}
