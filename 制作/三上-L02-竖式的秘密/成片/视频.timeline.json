  "audio": "files",
  "audio_dir": "/Users/charles/Desktop/Projects/小学数学/制作/三上-L02-竖式的秘密/配音-开朗学长-v1",
  "voice_id": "zh_male_kailangxuezhang_uranus_bigtts",
  "burn_captions": true,
  "scenes": [
    {
      "id": "g3a_l02_s1_1",
      "start": 0.0,
      "duration": 8.916666666666666,
      "narration": "三十八加四十七，有人算成了七百一十五。他把十五直接写在个位下面，漏了哪一步？",
      "speech_duration": 8.28,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s2_1",
      "start": 8.916667,
      "duration": 9.875,
      "narration": "每个小点表示一元，每框十个点就是十元。三十八和四十七合起来，有七个十和十五个一。",
      "speech_duration": 9.24,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s3_1",
      "start": 18.791667,
      "duration": 9.458333333333334,
      "narration": "把十五个一里的十个一，换成一个十。还剩五个一。总量没有变，十位多了一个十。",
      "speech_duration": 8.83201814058957,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s4_1",
      "start": 28.25,
      "duration": 10.25,
      "narration": "个位写五，向十位进一。这个一表示一个十。十位三加四再加一，得到八。答案是八十五。",
      "speech_duration": 9.648004535147392,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s5_1",
      "start": 38.5,
      "duration": 9.291666666666666,
      "narration": "再看五十二减二十七。五十二有五个十、两个一。个位的二不够减七，怎么办？",
      "speech_duration": 8.664013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s6_1",
      "start": 47.791667,
      "duration": 8.875,
      "narration": "拿出一个十，拆成十个一。原来的两个一也在，现在有四个十、十二个一，仍是五十二。",
      "speech_duration": 8.256009070294784,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s7_1",
      "start": 56.666667,
      "duration": 5.291666666666667,
      "narration": "从十二个一里拿走七个，从四个十里拿走两个。",
      "speech_duration": 4.656009070294784,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s7_2",
      "start": 61.958333,
      "duration": 6.458333333333333,
      "narration": "红点是拿走的，蓝点还剩两个十、五个一，就是二十五。",
      "speech_duration": 5.8560090702947845,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s8_1",
      "start": 68.416667,
      "duration": 16.666666666666668,
      "narration": "轮到你。一百减二十八，十位和个位都是零，怎么拆？先暂停，拿纸和笔试一试。",
      "speech_duration": 8.64,
      "pause_after": 8
    },
    {
      "id": "g3a_l02_s9_1",
      "start": 85.083333,
      "duration": 7.833333333333333,
      "narration": "百位拿出一个百，先换成十个十。画面里的每个小点还在，总量仍然是一百。",
      "speech_duration": 7.224013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s10_1",
      "start": 92.916667,
      "duration": 9.25,
      "narration": "再把其中一个十拆开，换成十个一。现在是九个十和十个一，可不是十个十再加十个一。",
      "speech_duration": 8.64,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l02_s11_1",
      "start": 102.166667,
      "duration": 7.833333333333333,
      "narration": "个位十减八得二，十位九减二得七。红点是拿走的二十八，蓝点还剩七十二。",
      "speech_duration": 7.224013605442177,
      "pause_after": 0.6
    }
  ]
}
