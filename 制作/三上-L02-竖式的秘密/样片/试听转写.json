[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "三十八加四十七"
  },
  {
    "start": 2.0,
    "end": 4.0,
    "text": "我们用长方形表示一个十"
  },
  {
    "start": 4.0,
    "end": 7.0,
    "text": "小圆片表示一个一"
  },
  {
    "start": 7.0,
    "end": 9.0,
    "text": "先把同样的单位放在一起"
  },
  {
    "start": 9.0,
    "end": 10.0,
    "text": "十有七个"
  },
  {
    "start": 10.0,
    "end": 12.0,
    "text": "一有十五个"
  },
  {
    "start": 12.0,
    "end": 15.0,
    "text": "十五个一可以怎么换"
  },
  {
    "start": 15.0,
    "end": 18.0,
    "text": "先圈出其中的十个一"
  },
  {
    "start": 18.0,
    "end": 20.0,
    "text": "把这十个一换成一个十"
  },
  {
    "start": 20.0,
    "end": 22.0,
    "text": "放到十位这边"
  },
  {
    "start": 22.0,
    "end": 24.0,
    "text": "还剩五个一"
  },
  {
    "start": 24.0,
    "end": 26.0,
    "text": "各位剩下五个一"
  },
  {
    "start": 26.0,
    "end": 29.0,
    "text": "所以先在各位写五"
  },
  {
    "start": 29.0,
    "end": 32.0,
    "text": "换来的一个十要记载十位"
  },
  {
    "start": 32.0,
    "end": 36.0,
    "text": "这个小小的一表示一个十"
  },
  {
    "start": 36.0,
    "end": 38.0,
    "text": "十位原来有七个十"
  },
  {
    "start": 38.0,
    "end": 42.0,
    "text": "加上换来的一个十一共是八个十"
  },
  {
    "start": 42.0,
    "end": 46.0,
    "text": "八个十和五个一合起来是八十五"
  },
  {
    "start": 46.0,
    "end": 50.0,
    "text": "尽位就是把满十个一换成一个十"
  }
]