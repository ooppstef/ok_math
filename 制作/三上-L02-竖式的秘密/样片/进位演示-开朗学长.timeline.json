  "burn_captions": true,
  "scenes": [
    {
      "id": "01-setup",
      "start": 0.0,
      "duration": 6.916666666666667,
      "narration": "三十八加四十七。我们用长方形表示一个十，小圆片表示一个一。"
    },
    {
      "id": "02-ones",
      "start": 6.916667,
      "duration": 5.541666666666667,
      "narration": "先把同样的单位放在一起。十有七个，一有十五个。"
    },
    {
      "id": "03-pack",
      "start": 12.458333,
      "duration": 6.125,
      "narration": "十五个一，可以怎么换？先圈出其中的十个一。"
    },
    {
      "id": "04-exchange",
      "start": 18.583333,
      "duration": 5.708333333333333,
      "narration": "把这十个一换成一个十，放到十位这边，还剩五个一。"
    },
    {
      "id": "05-write",
      "start": 24.291667,
      "duration": 4.708333333333333,
      "narration": "个位剩下五个一，所以先在个位写五。"
    },
    {
      "id": "06-carry",
      "start": 29.0,
      "duration": 7.125,
      "narration": "换来的一个十，要记在十位。这个小小的一，表示一个十。"
    },
    {
      "id": "07-tens",
      "start": 36.125,
      "duration": 6.125,
      "narration": "十位原来有七个十，加上换来的一个十，一共是八个十。"
    },
    {
      "id": "08-answer",
      "start": 42.25,
      "duration": 8.333333333333334,
      "narration": "八个十和五个一，合起来是八十五。进位，就是把满十个一换成一个十。"
    }
  ]
}
