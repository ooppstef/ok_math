  "scenes": [
    {
      "id": "g6b_l08_s1",
      "start": 0.0,
      "duration": 6.875,
      "narration": "这块面积十二平方厘米。长变成六，宽应该变多少，面积才不变？",
      "speech_duration": 6.264013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g6b_l08_s2",
      "start": 6.875,
      "duration": 8.666666666666666,
      "narration": "长变长的同时，宽要按十二除以长来计算。长变成两倍，宽就变成一半。",
      "speech_duration": 8.064013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g6b_l08_s3",
      "start": 15.541667,
      "duration": 7.041666666666667,
      "narration": "变的是长和宽，不变的是乘积十二。这种关系叫反比例。",
      "speech_duration": 6.4320181405895696,
      "pause_after": 0.6
    },
    {
      "id": "g6b_l08_s4",
      "start": 22.583333,
      "duration": 16.666666666666668,
      "narration": "另一块只固定周长。长四宽二，改成长五宽一，也是一大一小。它们成反比例吗？",
      "speech_duration": 8.664013605442177,
      "pause_after": 8
    },
    {
      "id": "g6b_l08_s5",
      "start": 39.25,
      "duration": 8.666666666666666,
      "narration": "不成。乘积从八变成五，保持的是和。判断反比例，要看乘积。",
      "speech_duration": 8.04,
      "pause_after": 0.6
    }
  ]
}
