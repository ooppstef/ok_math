{
  "no": "01",
  "kicker": "为什么实验室 · 三上",
  "footer": "小学数学 · 看见原理",
  "audience": "三上 · 原理短片",
  "scenes": [
    {
      "id": "g3a_l01_s1_1",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 1,
      "phase_start": 0.0,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 11.18,
      "narration": "九根小棒再添一根，一共有十根。十为什么写成一和零？把小棒捆一捆，就能看明白。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s2_1",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 2,
      "phase_start": 0.0,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 10.29,
      "narration": "把这十根小棒捆成一捆。小棒一根也没少，还是十根。十个一，换成了一个十。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s3_1",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 3,
      "phase_start": 0.0,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 10.0,
      "narration": "二十三，就是两捆，再加三根。两个十，三个一。十成了一个新的计数单位。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s4_1",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 4,
      "phase_start": 0.0,
      "phase_end": 0.5,
      "title": "满十进一",
      "duration": 7.35,
      "narration": "看二十二。右边的二表示两个一，左边的二表示两个十。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s4_2",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 4,
      "phase_start": 0.5,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 5.59,
      "narration": "数字一样，位置不同，表示的大小就不同。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s5_1",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 5,
      "phase_start": 0.0,
      "phase_end": 0.5,
      "title": "满十进一",
      "duration": 8.24,
      "narration": "三百零五，有三个百、零个十和五个一。十位的零要占住位置。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s5_2",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 10,
      "phase_start": 0.0,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 5.0,
      "narration": "去掉它，三就移到十位，变成三十五。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s6_1",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 6,
      "phase_start": 0.0,
      "phase_end": 0.5,
      "title": "满十进一",
      "duration": 8.53,
      "narration": "二十三加四十五，把三个一和五个一相加，两个十和四个十相加。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s6_2",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 6,
      "phase_start": 0.5,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 5.0,
      "narration": "得到六个十、八个一，也就是六十八。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s7_1",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 7,
      "phase_start": 0.0,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 9.41,
      "narration": "九十九加一。先把十个一捆成一个十。十位又有十个十，再合成一个百。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s7_2",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 7,
      "phase_start": 1.0,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 4.71,
      "narration": "小棒始终是一百根，最后记成一百。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s8_1",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 8,
      "phase_start": 0.0,
      "phase_end": 0.5,
      "title": "满十进一",
      "duration": 9.12,
      "narration": "用零、三、七，每个数字用一次，组成最大的三位数和最小的三位数。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s8_2",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 8,
      "phase_start": 0.5,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 5.29,
      "narration": "先暂停，写下两个数。百位能不能放零？",
      "pause_after": 8
    },
    {
      "id": "g3a_l01_s9_1",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 9,
      "phase_start": 0.0,
      "phase_end": 0.5,
      "title": "满十进一",
      "duration": 4.71,
      "narration": "最大是七百三十，最小是三百零七。",
      "pause_after": 0.6
    },
    {
      "id": "g3a_l01_s9_2",
      "type": "principle_foundation",
      "model": "place_value",
      "stage": 9,
      "phase_start": 0.5,
      "phase_end": 1.0,
      "title": "满十进一",
      "duration": 7.35,
      "narration": "三位数的百位不能放零，所以先放三，再把零放在十位。",
      "pause_after": 0.6
    }
  ]
}
