  "scenes": [
    {
      "id": "01",
      "start": 0.0,
      "duration": 8.25,
      "narration": "两个正方形的边长都是三厘米。每个周长十二厘米，分开放，周长合计二十四厘米。",
      "speech_duration": 7.248004535147392,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 8.25,
      "duration": 6.666666666666667,
      "narration": "让两块贴紧。原来每块各有一条边，现在都藏到里面了。",
      "speech_duration": 5.64,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 14.916667,
      "duration": 8.458333333333334,
      "narration": "沿外面走一圈，不经过接缝。长六、宽三，周长是十八厘米。",
      "speech_duration": 6.4320181405895696,
      "pause_after": 2
    },
    {
      "id": "04",
      "start": 23.375,
      "duration": 16.291666666666668,
      "narration": "换成一个长六、宽四的长方形。从角上剪掉边长二的小正方形，周长会比二十厘米少吗？",
      "speech_duration": 8.256009070294784,
      "pause_after": 8
    },
    {
      "id": "05",
      "start": 39.666667,
      "duration": 7.875,
      "narration": "没有变，仍是二十厘米。去掉两段二厘米，又添回同样长的两段。",
      "speech_duration": 5.8560090702947845,
      "pause_after": 2
    }
  ]
}
