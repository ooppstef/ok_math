[
  {
    "start": 0.0,
    "end": 2.4,
    "text": "十二出一三等于四"
  },
  {
    "start": 3.04,
    "end": 4.96,
    "text": "可是十二出一三"
  },
  {
    "start": 4.96,
    "end": 7.24,
    "text": "可以表示两件完全不同的事"
  },
  {
    "start": 8.16,
    "end": 8.96,
    "text": "第一件"
  },
  {
    "start": 9.36,
    "end": 12.0,
    "text": "十二科堂平均分给三个人"
  },
  {
    "start": 12.24,
    "end": 13.48,
    "text": "一个人四科"
  },
  {
    "start": 13.84,
    "end": 16.44,
    "text": "这里问的是每份有几个"
  },
  {
    "start": 17.48,
    "end": 18.240000000000002,
    "text": "第二件"
  },
  {
    "start": 18.72,
    "end": 21.240000000000002,
    "text": "十二科堂每三科装一带"
  },
  {
    "start": 21.44,
    "end": 22.56,
    "text": "能装四带"
  },
  {
    "start": 23.12,
    "end": 25.560000000000002,
    "text": "这里问的是能装几分"
  },
  {
    "start": 26.52,
    "end": 28.68,
    "text": "同样是十二出一三等于四"
  },
  {
    "start": 28.68,
    "end": 35.84,
    "text": "一个问每分多少,一个问有几分,答案一样,因为三成四等于十二,"
  },
  {
    "start": 35.84,
    "end": 45.56,
    "text": "厨法是惩罚的反方向,十三颗堂,每三颗装一带,装满四带还剩一颗,"
  },
  {
    "start": 45.56,
    "end": 56.32,
    "text": "十三处以三,伤四于一,剩下的一颗够装满一带吗,不够,还差两颗,"
  },
  {
    "start": 56.32,
    "end": 58.160000000000004,
    "text": "余述必须比除树小"
  },
  {
    "start": 59.16,
    "end": 60.6,
    "text": "如果还剩三颗"
  },
  {
    "start": 60.6,
    "end": 62.0,
    "text": "就能再装满一袋"
  },
  {
    "start": 62.480000000000004,
    "end": 64.36,
    "text": "说明刚才还没有分完"
  },
  {
    "start": 65.24,
    "end": 67.2,
    "text": "能到你十七处一五"
  },
  {
    "start": 67.44,
    "end": 68.44,
    "text": "将两个故事"
  },
  {
    "start": 68.8,
    "end": 70.16,
    "text": "一个是分给五个人"
  },
  {
    "start": 70.16,
    "end": 71.6,
    "text": "一个是每五个一袋"
  },
  {
    "start": 72.48,
    "end": 73.68,
    "text": "再纸上画一画"
  },
  {
    "start": 82.03999999999999,
    "end": 83.4,
    "text": "十七处一五"
  },
  {
    "start": 83.4,
    "end": 84.44,
    "text": "伤三于二"
  },
  {
    "start": 84.44,
    "end": 89.03999999999999,
    "text": "平均分给五个人,每人三颗,还剩两颗。"
  },
  {
    "start": 89.03999999999999,
    "end": 93.36,
    "text": "每五颗装一带,能装满三带,也剩两颗。"
  },
  {
    "start": 93.36,
    "end": 100.2,
    "text": "数字相同,可是一个三表示每人三颗,另一个三表示三带。"
  },
  {
    "start": 100.2,
    "end": 106.0,
    "text": "用诚法检查,五成三,再加剩下的二,正好是十七。"
  },
  {
    "start": 106.0,
    "end": 112.6,
    "text": "看到厨法,要看清求的是每分几个,还是一共有几分。"
  }
