[
  {
    "start": 0.0,
    "end": 3.04,
    "text": "四分之三米里有两段八分之三米"
  },
  {
    "start": 3.36,
    "end": 4.96,
    "text": "用同样的小段来数"
  },
  {
    "start": 5.12,
    "end": 6.76,
    "text": "六处以三就是二"
  },
  {
    "start": 7.5600000000000005,
    "end": 9.84,
    "text": "再看三分之二处以五分之四"
  },
  {
    "start": 10.24,
    "end": 11.8,
    "text": "都换成十五分之一"
  },
  {
    "start": 12.040000000000001,
    "end": 14.48,
    "text": "分别是十小段和十二小段"
  },
  {
    "start": 15.4,
    "end": 17.32,
    "text": "十二小段算一整分"
  },
  {
    "start": 17.8,
    "end": 20.52,
    "text": "十小段占这一份的六分之五"
  },
  {
    "start": 21.16,
    "end": 23.64,
    "text": "伤不够一也可以表示不满一份"
  },
  {
    "start": 24.68,
    "end": 26.96,
    "text": "想把五分之四这一份变成一"
  },
  {
    "start": 27.16,
    "end": 28.96,
    "text": "应先处一挤再成几"
  },
  {
    "start": 28.96,
    "end": 30.96,
    "text": "總量要標一起變"
  },
  {
    "start": 38.96,
    "end": 42.96,
    "text": "先處以四,再成五,也就是成四分之五"
  },
  {
    "start": 42.96,
    "end": 45.96,
    "text": "總量同步這樣變,分數不變"
  },
  {
    "start": 46.96,
    "end": 49.96,
    "text": "這就解釋了,為什麼處以分數可以成到數"
  }
