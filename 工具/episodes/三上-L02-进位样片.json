      "id": "01-setup", "type": "regroup_add", "stage": "setup", "duration": 8,
      "equation": "38 ＋ 47 = ?",
      "narration": "三十八加四十七。我们用长方形表示一个十，小圆片表示一个一。"
    },
    {
      "id": "02-ones", "type": "regroup_add", "stage": "ones", "duration": 8,
      "equation": "8 个一 ＋ 7 个一 = 15 个一",
      "narration": "先把同样的单位放在一起。十有七个，一有十五个。"
    },
    {
      "id": "03-pack", "type": "regroup_add", "stage": "pack", "duration": 7,
      "equation": "15 个一 = 10 个一 ＋ 5 个一",
      "narration": "十五个一，可以怎么换？先圈出其中的十个一。"
    },
    {
      "id": "04-exchange", "type": "regroup_add", "stage": "exchange", "duration": 9,
      "equation": "10 个一 = 1 个十",
      "narration": "把这十个一换成一个十，放到十位这边，还剩五个一。"
    },
    {
      "id": "05-write", "type": "regroup_add", "stage": "write", "duration": 6,
      "equation": "个位写 5",
      "narration": "个位剩下五个一，所以先在个位写五。"
    },
    {
      "id": "06-carry", "type": "regroup_add", "stage": "carry", "duration": 8,
      "equation": "进位的 1，表示 1 个十",
      "narration": "换来的一个十，要记在十位。这个小小的一，表示一个十。"
    },
    {
      "id": "07-tens", "type": "regroup_add", "stage": "tens", "duration": 7,
      "result_fraction": 0.6,
      "equation": "3 个十 ＋ 4 个十 ＋ 1 个十 = 8 个十",
      "narration": "十位原来有七个十，加上换来的一个十，一共是八个十。"
    },
    {
      "id": "08-answer", "type": "regroup_add", "stage": "answer", "duration": 7,
      "equation": "38 ＋ 47 = 85",
      "narration": "八个十和五个一，合起来是八十五。进位，就是把满十个一换成一个十。"
    }
  ]
