    {
      "id": "01",
      "start": 2.6,
      "duration": 5.375,
      "narration": "把这个圆平均分成十二个扇形。每一块都有弯弯的圆弧。",
      "speech_duration": 4.368004535147392,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 7.975,
      "duration": 6.916666666666667,
      "narration": "把这些扇形交错排好。每块只转方向、换位置，没有拉伸。",
      "speech_duration": 4.8960090702947845,
      "pause_after": 2
    },
    {
      "id": "03",
      "start": 14.891667,
      "duration": 7.916666666666667,
      "narration": "看，上下仍然有小弧线。有限块拼出的图形，还不是精确的长方形。",
      "speech_duration": 5.88,
      "pause_after": 2
    },
    {
      "id": "04",
      "start": 22.808333,
      "duration": 8.083333333333334,
      "narration": "分得越来越细，长接近半个圆周，也就是圆周率乘半径。宽接近半径。",
      "speech_duration": 6.048004535147392,
      "pause_after": 2
    },
    {
      "id": "05",
      "start": 30.891667,
      "duration": 8.083333333333334,
      "narration": "沿着这个越来越接近的过程，可以理解圆的面积，等于圆周率乘半径的平方。",
      "speech_duration": 6.048004535147392,
      "pause_after": 2
    },
    {
      "id": "06",
      "start": 38.975,
      "duration": 11.916666666666666,
      "narration": "半径变为原来的两倍，圆的面积也只变两倍吗？",
      "speech_duration": 3.888004535147392,
      "pause_after": 8
    },
    {
      "id": "07",
      "start": 50.891667,
      "duration": 7.416666666666667,
      "narration": "不是两倍，是四倍。公式里两个半径都变成两倍，要乘两次。",
      "speech_duration": 5.376009070294785,
      "pause_after": 2
    }
  ]
