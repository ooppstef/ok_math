  "scenes": [
    {
      "id": "g6a_l12_s1_1",
      "start": 0.0,
      "duration": 5.833333333333333,
      "narration": "一个点，再添三个，摆成每边两个点的正方形。",
      "speech_duration": 5.232018140589569,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l12_s2_1",
      "start": 5.833333,
      "duration": 5.875,
      "narration": "再添五个，再添七个。每次都补右边一列和下面一行。",
      "speech_duration": 5.256009070294785,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l12_s3_1",
      "start": 11.708333,
      "duration": 6.625,
      "narration": "每边五个点时，新的一列有五个，下面再添四个，共九个。",
      "speech_duration": 6.0240136054421765,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l12_s3_2",
      "start": 18.333333,
      "duration": 6.458333333333333,
      "narration": "每边有多少个，新的一列就有多少个，下面一行比它少一个。",
      "speech_duration": 5.8560090702947845,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l12_s4_1",
      "start": 24.791667,
      "duration": 12.875,
      "narration": "从每边三个点变成每边五个点，要添哪两个奇数？",
      "speech_duration": 4.848004535147393,
      "pause_after": 8
    },
    {
      "id": "g6a_l12_s5_1",
      "start": 37.666667,
      "duration": 12.083333333333334,
      "narration": "添七个，再添九个，一共十六个。用大正方形二十五个减小正方形九个，也得到十六。",
      "speech_duration": 11.448004535147392,
      "pause_after": 0.6
    }
  ]
}
