      "id": "01",
      "start": 2.6,
      "duration": 7.25,
      "narration": "针尖不动，张开的距离不变。笔尖转一圈，每一点到圆心都一样远。",
      "speech_duration": 6.24,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 9.85,
      "duration": 7.083333333333333,
      "narration": "圆心决定位置，半径决定大小。直径经过圆心，长是半径的两倍。",
      "speech_duration": 6.048004535147392,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 16.933333,
      "duration": 7.25,
      "narration": "想象沿圆周放一条不伸长的细线，剪开、慢慢展开。它的长度就是圆周长。",
      "speech_duration": 6.216009070294785,
      "pause_after": 1
    },
    {
      "id": "04",
      "start": 24.183333,
      "duration": 8.708333333333334,
      "narration": "用直径来比，周长略多于三个直径。它们的比叫圆周率，三点一四只是近似值。",
      "speech_duration": 6.696009070294784,
      "pause_after": 2
    },
    {
      "id": "05",
      "start": 32.891667,
      "duration": 11.75,
      "narration": "把圆的直径变成原来的两倍，圆周长会变成几倍？",
      "speech_duration": 3.72,
      "pause_after": 8
    },
    {
      "id": "06",
      "start": 44.641667,
      "duration": 7.25,
      "narration": "周长也变成两倍。圆周率不变，直径乘二，周长也乘二。",
      "speech_duration": 5.232018140589569,
      "pause_after": 2
    }
  ]
}
