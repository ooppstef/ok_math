  "audio_dir": "/Users/charles/Desktop/Projects/小学数学/制作/六上-L02-分数除法/配音-开朗学长-v1",
  "voice_id": "zh_male_kailangxuezhang_uranus_bigtts",
  "burn_captions": true,
  "scenes": [
    {
      "id": "g6a_l02_s1_1",
      "start": 0.0,
      "duration": 7.458333333333333,
      "narration": "四分之三米里，有两段八分之三米。用同样的小段来数，六除以三就是二。",
      "speech_duration": 6.84,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l02_s2_1",
      "start": 7.458333,
      "duration": 7.833333333333333,
      "narration": "再看三分之二除以五分之四。都换成十五分之一，分别是十小段和十二小段。",
      "speech_duration": 7.224013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l02_s3_1",
      "start": 15.291667,
      "duration": 9.25,
      "narration": "十二小段算一整份，十小段占这一份的六分之五。商不够一，也可以表示不满一份。",
      "speech_duration": 8.64,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l02_s4_1",
      "start": 24.541667,
      "duration": 14.625,
      "narration": "想把五分之四这一份变成一，应先除以几，再乘几？总量要不要一起变？",
      "speech_duration": 6.624013605442177,
      "pause_after": 8
    },
    {
      "id": "g6a_l02_s5_1",
      "start": 39.166667,
      "duration": 8.083333333333334,
      "narration": "先除以四，再乘五，也就是乘四分之五。总量同步这样变，份数不变。",
      "speech_duration": 7.464013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g6a_l02_s5_2",
      "start": 47.25,
      "duration": 4.083333333333333,
      "narration": "这就解释了为什么除以分数可以乘倒数。",
      "speech_duration": 3.48,
      "pause_after": 0.6
    }
  ]
}
