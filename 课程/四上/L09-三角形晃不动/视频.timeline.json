  "scenes": [
    {
      "id": "01",
      "start": 0.0,
      "duration": 8.666666666666666,
      "narration": "底棒的两个端点固定。另两根棒能转，却不能变长。它们的自由端必须碰在一起。",
      "speech_duration": 7.632018140589569,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 8.666667,
      "duration": 10.458333333333334,
      "narration": "碰在一起时，顶点的位置就定了。三根棒长三、四、五，不能随手推成更扁的三角形。",
      "speech_duration": 8.448004535147392,
      "pause_after": 2
    },
    {
      "id": "03",
      "start": 19.125,
      "duration": 10.083333333333334,
      "narration": "看四边形。四根棒没有伸缩，接点转动，它仍然能推斜。对角线的长度在变。",
      "speech_duration": 9.048004535147392,
      "pause_after": 1
    },
    {
      "id": "04",
      "start": 29.208333,
      "duration": 14.291666666666666,
      "narration": "加上这根固定长度的斜撑，里面分成什么图形？还能照原样推斜吗？",
      "speech_duration": 6.264013605442177,
      "pause_after": 8
    },
    {
      "id": "05",
      "start": 43.5,
      "duration": 8.458333333333334,
      "narration": "分成两个三角形。每个三角形的边长都固定，框架的形状也固定了。",
      "speech_duration": 6.4320181405895696,
      "pause_after": 2
    }
  ]
}
