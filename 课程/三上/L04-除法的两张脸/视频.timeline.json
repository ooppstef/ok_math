  "scenes": [
    {
      "id": "g3a_l04_s1_1",
      "start": 0.0,
      "duration": 8.083333333333334,
      "narration": "12 除以 3 等于 4。可是，12÷3 可以表示两件完全不同的事。",
      "speech_duration": 7.464013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s2_1",
      "start": 8.083333,
      "duration": 9.25,
      "narration": "第一件：12 颗糖，平均分给 3 个人。一个人 4 颗。这里问的是：每份有几个？",
      "speech_duration": 8.64,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s3_1",
      "start": 17.333333,
      "duration": 9.041666666666666,
      "narration": "第二件：12 颗糖，每 3 颗装一袋。能装 4 袋。这里问的是：能装几份？",
      "speech_duration": 8.424013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s4_1",
      "start": 26.375,
      "duration": 10.291666666666666,
      "narration": "同样是 12÷3=4，一个问每份多少，一个问有几份。答案一样，因为 3×4=12。",
      "speech_duration": 9.67201814058957,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s4_2",
      "start": 36.666667,
      "duration": 3.0833333333333335,
      "narration": "除法是乘法的反方向。",
      "speech_duration": 2.4480045351473922,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s5_1",
      "start": 39.75,
      "duration": 6.458333333333333,
      "narration": "13 颗糖，每 3 颗装一袋。装满 4 袋，还剩 1 颗。",
      "speech_duration": 5.8560090702947845,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s5_2",
      "start": 46.208333,
      "duration": 8.083333333333334,
      "narration": "13 除以 3，商 4 余 1。剩下的 1 颗，够装满一袋吗？",
      "speech_duration": 7.464013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s6_1",
      "start": 54.291667,
      "duration": 4.875,
      "narration": "不够，还差两颗。余数必须比除数小。",
      "speech_duration": 4.248004535147392,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s6_2",
      "start": 59.166667,
      "duration": 6.083333333333333,
      "narration": "如果还剩 3 颗，就能再装满一袋，说明刚才还没有分完。",
      "speech_duration": 5.448004535147392,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s7_1",
      "start": 65.25,
      "duration": 7.291666666666667,
      "narration": "轮到你：17÷5，讲两个故事。一个是分给 5 个人，一个是每 5 个一袋。",
      "speech_duration": 6.672018140589569,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s7_2",
      "start": 72.541667,
      "duration": 9.5,
      "narration": "在纸上画一画。",
      "speech_duration": 1.4640136054421768,
      "pause_after": 8
    },
    {
      "id": "g3a_l04_s8_1",
      "start": 82.041667,
      "duration": 7.458333333333333,
      "narration": "17 除以 5，商 3 余 2。平均分给五个人，每人三颗，还剩两颗。",
      "speech_duration": 6.84,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s8_2",
      "start": 89.5,
      "duration": 4.25,
      "narration": "每五颗装一袋，能装满三袋，也剩两颗。",
      "speech_duration": 3.6480045351473924,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s8_3",
      "start": 93.75,
      "duration": 6.875,
      "narration": "数字相同，可是一个三表示每人三颗，另一个三表示三袋。",
      "speech_duration": 6.264013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s9_1",
      "start": 100.625,
      "duration": 5.833333333333333,
      "narration": "用乘法检查：五乘三，再加剩下的二，正好是十七。",
      "speech_duration": 5.232018140589569,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l04_s9_2",
      "start": 106.458333,
      "duration": 6.5,
      "narration": "看到除法，要看清求的是每份几个，还是一共有几份。",
      "speech_duration": 5.88,
      "pause_after": 0.6
    }
  ]
