  "scenes": [
    {
      "id": "g3a_l03_s1_1",
      "start": 2.6,
      "duration": 8.5,
      "narration": "十二颗棋子排成三行，每行四颗。四个四个地数，三个四，一共十二。",
      "speech_duration": 7.8960090702947845,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s2_1",
      "start": 11.1,
      "duration": 7.666666666666667,
      "narration": "把同一批棋子一起转九十度。每两颗棋子间的距离不变，三行四列变成四行三列。",
      "speech_duration": 7.032018140589569,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s2_2",
      "start": 18.766667,
      "duration": 2.0,
      "narration": "总数还是十二。",
      "speech_duration": 1.3680045351473924,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s3_1",
      "start": 20.766667,
      "duration": 7.666666666666667,
      "narration": "再摆六行，每行七颗，一共四十二颗。一起转过来，就是七行，每行六颗。",
      "speech_duration": 7.056009070294785,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s3_2",
      "start": 28.433333,
      "duration": 2.6666666666666665,
      "narration": "六乘七和七乘六也相等。",
      "speech_duration": 2.04,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s4_1",
      "start": 31.1,
      "duration": 3.8333333333333335,
      "narration": "如果最后一行缺了一颗，每行就不一样多了。",
      "speech_duration": 3.2160090702947848,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s4_2",
      "start": 34.933333,
      "duration": 5.833333333333333,
      "narration": "这时是四加四加三，只有十一颗，不能直接算成三乘四。",
      "speech_duration": 5.208004535147392,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s5_1",
      "start": 40.766667,
      "duration": 9.625,
      "narration": "十二颗还能摆成一行十二颗、两行六颗、三行四颗。转向算同一种，有三种。",
      "speech_duration": 9.024013605442176,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s5_2",
      "start": 50.391667,
      "duration": 2.6666666666666665,
      "narration": "行列分开算，有六种。",
      "speech_duration": 2.04,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s6_1",
      "start": 53.058333,
      "duration": 6.541666666666667,
      "narration": "现在用二十四颗棋子，摆每行一样多的完整长方形。规定转九十度算同一种。",
      "speech_duration": 5.904013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s6_2",
      "start": 59.6,
      "duration": 10.25,
      "narration": "先暂停，找出所有摆法。",
      "speech_duration": 2.2320181405895694,
      "pause_after": 8
    },
    {
      "id": "g3a_l03_s7_1",
      "start": 69.85,
      "duration": 8.5,
      "narration": "一行二十四颗，两行十二颗，三行八颗，四行六颗。转过来的算同一种，一共有四种。",
      "speech_duration": 7.8960090702947845,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s8_1",
      "start": 78.35,
      "duration": 6.0,
      "narration": "这里有四行，每行二十五颗。四个二十五相加是一百。",
      "speech_duration": 5.4,
      "pause_after": 0.6
    },
    {
      "id": "g3a_l03_s8_2",
      "start": 84.35,
      "duration": 5.208333333333333,
      "narration": "写成乘法，四乘二十五，也等于二十五乘四。",
      "speech_duration": 4.584013605442177,
      "pause_after": 0.6
    }
  ]
}
