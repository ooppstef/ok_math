  "scenes": [
    {
      "id": "01",
      "start": 2.6,
      "duration": 6.583333333333333,
      "narration": "先检查：圆锥和圆柱内部的底面一样大，高也一样。这是比较时的条件。",
      "speech_duration": 5.544013605442177,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 9.183333,
      "duration": 6.916666666666667,
      "narration": "先在圆锥里装满水，把这一锥水倒进圆柱。看，圆柱里有了一份水。",
      "speech_duration": 5.904013605442177,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 16.1,
      "duration": 5.25,
      "narration": "再装满一锥水，倒进去。圆柱里的水变成了两份。",
      "speech_duration": 4.248004535147392,
      "pause_after": 1
    },
    {
      "id": "04",
      "start": 21.35,
      "duration": 5.708333333333333,
      "narration": "第三次装满，再倒进去。这回正好装满了等底等高的圆柱。",
      "speech_duration": 4.704013605442177,
      "pause_after": 1
    },
    {
      "id": "05",
      "start": 27.058333,
      "duration": 9.75,
      "narration": "圆锥体积，是等底等高圆柱的三分之一。动画画出了关系，不能把画好的水位当成普遍证明。",
      "speech_duration": 7.7280045351473925,
      "pause_after": 2
    },
    {
      "id": "06",
      "start": 36.808333,
      "duration": 13.583333333333334,
      "narration": "如果只知道高相同，不知道底面是否一样，还能直接说体积是三分之一吗？",
      "speech_duration": 5.568004535147392,
      "pause_after": 8
    },
    {
      "id": "07",
      "start": 50.391667,
      "duration": 7.041666666666667,
      "narration": "不能直接套。必须检查底面和高，或者分别计算体积，再作比较。",
      "speech_duration": 5.04,
      "pause_after": 2
    }
  ]
}
