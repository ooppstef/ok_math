  "scenes": [
    {
      "id": "01",
      "start": 0.0,
      "duration": 7.291666666666667,
      "narration": "把圆平均分成扇形，再沿着高切下去。每一块都连着同样高的部分。",
      "speech_duration": 6.264013605442177,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 7.291667,
      "duration": 8.25,
      "narration": "把这些扇形柱交错排好。每块只转方向、换位置，没有拉伸，高也没有改变。",
      "speech_duration": 7.224013605442177,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 15.541667,
      "duration": 11.875,
      "narration": "拼好后仍有弯曲的小边。分得越细，就越接近长方体，不能把有限块说成已经完全一样。",
      "speech_duration": 9.864013605442176,
      "pause_after": 2
    },
    {
      "id": "04",
      "start": 27.416667,
      "duration": 10.708333333333334,
      "narration": "沿着越来越接近的过程，可以理解圆柱体积。底面积是圆周率乘半径平方，再乘高。",
      "speech_duration": 8.688004535147392,
      "pause_after": 2
    },
    {
      "id": "05",
      "start": 38.125,
      "duration": 14.291666666666666,
      "narration": "底面积十二平方厘米，只把高增加一厘米，多出的体积是多少？",
      "speech_duration": 6.264013605442177,
      "pause_after": 8
    },
    {
      "id": "06",
      "start": 52.416667,
      "duration": 7.916666666666667,
      "narration": "多出一层底面积十二、高一厘米的圆柱。体积增加十二立方厘米。",
      "speech_duration": 5.88,
      "pause_after": 2
    }
  ]
}
