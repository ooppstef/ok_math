      "id": "01",
      "start": 0.0,
      "duration": 7.458333333333333,
      "narration": "平行的两条边，长三厘米和五厘米。它们之间的垂直距离是四厘米。",
      "speech_duration": 6.4320181405895696,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 7.458333,
      "duration": 5.666666666666667,
      "narration": "复制一块完全一样的梯形，绕右边这条腰的中点转半圈。",
      "speech_duration": 4.656009070294784,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 13.125,
      "duration": 6.916666666666667,
      "narration": "两块拼成平行四边形。底是五加三，等于八，高还是四。",
      "speech_duration": 5.88,
      "pause_after": 1
    },
    {
      "id": "04",
      "start": 20.041667,
      "duration": 12.875,
      "narration": "三十二是几块梯形的面积？原来一块是多少？",
      "speech_duration": 4.848004535147393,
      "pause_after": 8
    },
    {
      "id": "05",
      "start": 32.916667,
      "duration": 8.083333333333334,
      "narration": "三十二是两块的面积。一块就是十六平方厘米，所以最后要除以二。",
      "speech_duration": 6.048004535147392,
      "pause_after": 2
    },
    {
      "id": "06",
      "start": 41.0,
      "duration": 10.666666666666666,
      "narration": "画一条对角线。两个三角形的底分别是三和五，高都是四。面积六加十，还是十六。",
      "speech_duration": 8.664013605442177,
      "pause_after": 2
    }
  ]
