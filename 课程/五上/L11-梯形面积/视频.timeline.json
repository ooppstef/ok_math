      "id": "01",
      "start": 2.6,
      "duration": 6.416666666666667,
      "narration": "平行的两条边，长三厘米和五厘米。它们之间的垂直距离是四厘米。",
      "speech_duration": 5.376009070294785,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 9.016667,
      "duration": 5.25,
      "narration": "复制一块完全一样的梯形，绕右边这条腰的中点转半圈。",
      "speech_duration": 4.224013605442177,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 14.266667,
      "duration": 5.916666666666667,
      "narration": "两块拼成平行四边形。底是五加三，等于八，高还是四。",
      "speech_duration": 4.8960090702947845,
      "pause_after": 1
    },
    {
      "id": "04",
      "start": 20.183333,
      "duration": 11.708333333333334,
      "narration": "三十二是几块梯形的面积？原来一块是多少？",
      "speech_duration": 3.6960090702947848,
      "pause_after": 8
    },
    {
      "id": "05",
      "start": 31.891667,
      "duration": 7.583333333333333,
      "narration": "三十二是两块的面积。一块就是十六平方厘米，所以最后要除以二。",
      "speech_duration": 5.568004535147392,
      "pause_after": 2
    },
    {
      "id": "06",
      "start": 39.475,
      "duration": 9.375,
      "narration": "画一条对角线。两个三角形的底分别是三和五，高都是四。面积六加十，还是十六。",
      "speech_duration": 7.368004535147392,
      "pause_after": 2
    }
  ]
