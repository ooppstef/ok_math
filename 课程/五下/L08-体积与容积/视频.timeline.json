      "id": "01",
      "start": 0.0,
      "duration": 7.291666666666667,
      "narration": "每个小正方体都是一立方厘米。底层三乘四，一共十二个。",
      "speech_duration": 6.264013605442177,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 7.291667,
      "duration": 7.25,
      "narration": "把同样的底层，依次叠到五层。每层十二块，就是五个十二。",
      "speech_duration": 6.24,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 14.541667,
      "duration": 9.666666666666666,
      "narration": "长乘宽数出一层有几块，再乘高数出有几层。这个长方体占六十立方厘米。",
      "speech_duration": 7.632018140589569,
      "pause_after": 2
    },
    {
      "id": "04",
      "start": 24.208333,
      "duration": 15.25,
      "narration": "现在换成一个容器，里面的长、宽、高都是十厘米。容量是多少立方厘米，合多少升？",
      "speech_duration": 7.248004535147392,
      "pause_after": 8
    },
    {
      "id": "05",
      "start": 39.458333,
      "duration": 10.875,
      "narration": "十乘十乘十，是一千立方厘米，也就是一升。容积要量里面，不能把盒壁算进去。",
      "speech_duration": 8.856009070294785,
      "pause_after": 2
    }
  ]
