      "start": 2.6,
      "duration": 5.708333333333333,
      "narration": "每个小正方体都是一立方厘米。底层三乘四，一共十二个。",
      "speech_duration": 4.704013605442177,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 8.308333,
      "duration": 6.416666666666667,
      "narration": "把同样的底层，依次叠到五层。每层十二块，就是五个十二。",
      "speech_duration": 5.376009070294785,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 14.725,
      "duration": 8.583333333333334,
      "narration": "长乘宽数出一层有几块，再乘高数出有几层。这个长方体占六十立方厘米。",
      "speech_duration": 6.576009070294784,
      "pause_after": 2
    },
    {
      "id": "04",
      "start": 23.308333,
      "duration": 14.041666666666666,
      "narration": "现在换成一个容器，里面的长、宽、高都是十厘米。容量是多少立方厘米，合多少升？",
      "speech_duration": 6.0240136054421765,
      "pause_after": 8
    },
    {
      "id": "05",
      "start": 37.35,
      "duration": 10.041666666666666,
      "narration": "十乘十乘十，是一千立方厘米，也就是一升。容积要量里面，不能把盒壁算进去。",
      "speech_duration": 8.04,
      "pause_after": 2
    }
  ]
