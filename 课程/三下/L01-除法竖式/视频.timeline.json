  "scenes": [
    {
      "id": "g3b_l01_s1_1",
      "start": 0.0,
      "duration": 6.083333333333333,
      "narration": "把五十六平均分成三份，先分五捆小棒，每捆十根。",
      "speech_duration": 5.47201814058957,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l01_s2_1",
      "start": 6.083333,
      "duration": 4.083333333333333,
      "narration": "每份先拿到一个十，还剩两个十。",
      "speech_duration": 3.4560090702947845,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l01_s3_1",
      "start": 10.166667,
      "duration": 9.875,
      "narration": "剩下两捆，拆成二十根，和原来的六根合在一起，共二十六根。每份再拿八根，最后剩两根。",
      "speech_duration": 9.24,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l01_s4_1",
      "start": 20.041667,
      "duration": 10.458333333333334,
      "narration": "为什么剩下的数必须比3小？",
      "speech_duration": 2.4480045351473922,
      "pause_after": 8
    },
    {
      "id": "g3b_l01_s5_1",
      "start": 30.5,
      "duration": 7.833333333333333,
      "narration": "换成五十七个试试。如果每份十八个，还剩三个，每份就能再拿一个。",
      "speech_duration": 7.2,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l01_s5_2",
      "start": 38.333333,
      "duration": 8.083333333333334,
      "narration": "要分到不能再平均分为止。原来五十六那题，商十八，余二。",
      "speech_duration": 7.464013605442177,
      "pause_after": 0.6
    }
  ]
}
