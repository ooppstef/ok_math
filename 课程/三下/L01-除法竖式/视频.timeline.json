      "id": "g3b_l01_s1_1",
      "start": 0.0,
      "duration": 5.458333333333333,
      "narration": "56平均分成三份，先把五个十分一分。",
      "speech_duration": 4.824013605442177,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l01_s2_1",
      "start": 5.458333,
      "duration": 4.083333333333333,
      "narration": "每份先拿到一个十，还剩两个十。",
      "speech_duration": 3.4560090702947845,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l01_s3_1",
      "start": 9.541667,
      "duration": 7.708333333333333,
      "narration": "26个一，每份还能拿8个，最后剩2个。每份合起来是18。",
      "speech_duration": 7.08,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l01_s4_1",
      "start": 17.25,
      "duration": 10.458333333333334,
      "narration": "为什么剩下的数必须比3小？",
      "speech_duration": 2.424013605442177,
      "pause_after": 8
    },
    {
      "id": "g3b_l01_s5_1",
      "start": 27.708333,
      "duration": 7.041666666666667,
      "narration": "换成五十七个试试。如果每份十八个，还剩三个，每份就能再拿一个。",
      "speech_duration": 6.4320181405895696,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l01_s5_2",
      "start": 34.75,
      "duration": 8.083333333333334,
      "narration": "要分到不能再平均分为止。原来五十六那题，商十八，余二。",
      "speech_duration": 7.464013605442177,
      "pause_after": 0.6
    }
  ]
