  "scenes": [
    {
      "id": "01",
      "start": 0.0,
      "duration": 7.708333333333333,
      "narration": "六个正方形都有名字。先让中间的字母C平放，跟着每个面一起折。",
      "speech_duration": 6.672018140589569,
      "pause_after": 1
    },
    {
      "id": "02",
      "start": 7.708333,
      "duration": 6.25,
      "narration": "把左边、右边和前面的三个侧面竖起来。底面仍然是字母C。",
      "speech_duration": 5.232018140589569,
      "pause_after": 1
    },
    {
      "id": "03",
      "start": 13.958333,
      "duration": 7.708333333333333,
      "narration": "再把连着的两个面折过去，补上后面和上面。六个面围成一个盒子。",
      "speech_duration": 6.672018140589569,
      "pause_after": 1
    },
    {
      "id": "04",
      "start": 21.666667,
      "duration": 14.041666666666666,
      "narration": "哪个面正对着底面C，中间隔着整个盒子？想好再看答案。",
      "speech_duration": 6.0240136054421765,
      "pause_after": 8
    },
    {
      "id": "05",
      "start": 35.708333,
      "duration": 9.5,
      "narration": "是字母E。另一对是B和D，还有A和F。相对的面不挨着。",
      "speech_duration": 7.464013605442177,
      "pause_after": 2
    }
  ]
}
