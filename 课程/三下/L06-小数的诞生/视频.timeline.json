  "scenes": [
    {
      "id": "g3b_l06_s1_1",
      "start": 0.0,
      "duration": 6.458333333333333,
      "narration": "一米分成十段，每段一分米。用米写，就是零点一米。",
      "speech_duration": 5.8560090702947845,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l06_s2_1",
      "start": 6.458333,
      "duration": 5.458333333333333,
      "narration": "走过三大格，是三个十分之一米，写成零点三米。",
      "speech_duration": 4.848004535147393,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l06_s3_1",
      "start": 11.916667,
      "duration": 8.25,
      "narration": "每大格再分十份。整条尺还是一米，细格一共一百个，每格零点零一米。",
      "speech_duration": 7.632018140589569,
      "pause_after": 0.6
    },
    {
      "id": "g3b_l06_s4_1",
      "start": 20.166667,
      "duration": 12.833333333333334,
      "narration": "原来的三大格，现在有多少个小格？长度变了吗？",
      "speech_duration": 4.824013605442177,
      "pause_after": 8
    },
    {
      "id": "g3b_l06_s5_1",
      "start": 33.0,
      "duration": 8.875,
      "narration": "三十小格，长度没变。三个十分之一，和三十个百分之一，是同样长。",
      "speech_duration": 8.256009070294784,
      "pause_after": 0.6
    }
  ]
}
